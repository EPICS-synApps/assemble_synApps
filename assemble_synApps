		system("make");
		warn "WARNING: uldaq make failed\n" if $? != 0;
		`make install || true`;
		
		unlink("../configure/CONFIG_SITE.local");
		add_line("USR_LDFLAGS+=-L${PWD}/lib", "../configure/CONFIG_SITE.local");
