# Print a progress message unless --quiet is set
sub info {
	print @_ unless $QUIET;
}

# Run a system command, suppressing stdout in quiet mode
sub run_cmd {
	my @cmd = @_;
	
	if ($QUIET)
	{
		open(my $save_stdout, ">&", \*STDOUT);
		open(STDOUT, ">", File::Spec->devnull());
		my $ret = system(@cmd);
		open(STDOUT, ">&", $save_stdout);
		return $ret;
	}
	
	return system(@cmd);
}


# Validates that a module name or tag contains only safe characters.
# Prevents shell injection when values are interpolated into commands.
sub validate_tag {
	my ($name, $value) = @_;
	
	if ($value !~ /^[A-Za-z0-9._-]+$/)
	{
		die "ERROR: Invalid value for $name: '$value' (only alphanumeric, '.', '-', '_' allowed)\n";
	}
}


#
# Used because the recursive copy library isn't included
# in all perl distributions
sub copy_recur {
	my @parms = @_;
	
	opendir(my $dirhandle, $parms[0]);
	
	while (readdir($dirhandle)) {
		next if($_ =~ /^\.$/);
		next if($_ =~ /^\.\.$/);
		
		move("$parms[0]/$_", "$parms[1]/$_");
	}
	
	closedir $dirhandle;
}


#
# Replaces all occurrences of a pattern in a file.
# Note: $search is used as a regex pattern. Use \Q...\E to match literal strings.
sub do_substitution {
	my ($search, $replace, $file) = @_;
	
	my $tmpfile = $file . '.tmp';
	
	open (my $in, '<', $file) or die "do_substitution: cannot read $file: $!\n";
	open (my $out, '>', $tmpfile) or die "do_substitution: cannot write $tmpfile: $!\n";
	while (<$in>)  {
		$_ =~ s/$search/$replace/g;
		print $out $_;
	}
	close ($in);
	close ($out);
	
	rename($tmpfile, $file) or die "do_substitution: cannot rename $tmpfile to $file: $!\n";
}



# Pulls a given repo or restores it to a clean state if it already exists
sub get_repo {
	my @parms = @_;
	
	my $PROJECT=$parms[0];
	my $MODULE_NAME=$parms[1];
	my $RELEASE_NAME=$parms[2];
	my $TAG=$parms[3];
	my $FILTER_TAG=$parms[3];
	my $REL = $parms[4];
	
	# Defense-in-depth: validate before shell interpolation
	validate_tag("$RELEASE_NAME project", $PROJECT);
	validate_tag("$RELEASE_NAME repo", $MODULE_NAME);
	validate_tag($RELEASE_NAME, $TAG);
	
	$FILTER_TAG =~ s/\./-/g;
	
	my $FOLDER_NAME="$MODULE_NAME-${FILTER_TAG}";
	
	if (! -d "${FOLDER_NAME}")
	{
		info "\n";
		info "Grabbing $MODULE_NAME at tag: $TAG\n";
		info "\n";
		
		run_cmd("git", "clone", @git_quiet, "https://github.com/$PROJECT/${MODULE_NAME}.git", "${FOLDER_NAME}");
		die "ERROR: Failed to clone $MODULE_NAME from $PROJECT\n" if $? != 0;
		
		chdir "$FOLDER_NAME" or die "ERROR: Cannot enter directory $FOLDER_NAME: $!\n";
		run_cmd("git", "checkout", @git_quiet, "$TAG");
		die "ERROR: Failed to checkout tag $TAG for $MODULE_NAME\n" if $? != 0;
		chdir ".." or die "ERROR: Cannot return to parent directory: $!\n";
		
		say $REL "$RELEASE_NAME=\$(SUPPORT)/$FOLDER_NAME";
		$updated{$RELEASE_NAME} = 1;
		
		info "\n";
	}
	elsif ($UPDATE)
	{
		# Check if already at the correct tag or branch
		chdir "$FOLDER_NAME" or die "ERROR: Cannot enter directory $FOLDER_NAME: $!\n";
		my $current_ref = `git describe --tags --exact-match HEAD 2>/dev/null`;
		if ($? != 0)
		{
			$current_ref = `git symbolic-ref --short HEAD 2>/dev/null`;
		}
		chomp $current_ref if defined $current_ref;
		chdir ".." or die "ERROR: Cannot return to parent directory: $!\n";
		
		if (defined $current_ref && $current_ref eq $TAG)
		{
			info "Skipping $MODULE_NAME (already at $TAG)\n";
			say $REL "$RELEASE_NAME=\$(SUPPORT)/$FOLDER_NAME";
		}
		else
		{
			info "\n";
			info "Updating $MODULE_NAME to tag: $TAG\n";
			info "\n";
			
			chdir "$FOLDER_NAME" or die "ERROR: Cannot enter directory $FOLDER_NAME: $!\n";
			run_cmd("git", "stash", @git_quiet);
			run_cmd("git", "clean", "-fdx");
			run_cmd("git", "checkout", @git_quiet, "$TAG");
			die "ERROR: Failed to checkout tag $TAG for $MODULE_NAME\n" if $? != 0;
			chdir ".." or die "ERROR: Cannot return to parent directory: $!\n";
			
			say $REL "$RELEASE_NAME=\$(SUPPORT)/$FOLDER_NAME";
			$updated{$RELEASE_NAME} = 1;
			
			info "\n";
		}
	}
	else
	{
		info "\n";
		info "Restoring $MODULE_NAME to tag: $TAG\n";
		info "\n";
		
		chdir "$FOLDER_NAME" or die "ERROR: Cannot enter directory $FOLDER_NAME: $!\n";
		run_cmd("git", "stash", @git_quiet);
		run_cmd("git", "clean", "-fdx");
		run_cmd("git", "checkout", @git_quiet, "$TAG");
		die "ERROR: Failed to checkout tag $TAG for $MODULE_NAME\n" if $? != 0;
		chdir ".." or die "ERROR: Cannot return to parent directory: $!\n";
		
		say $REL "$RELEASE_NAME=\$(SUPPORT)/$FOLDER_NAME";
		$updated{$RELEASE_NAME} = 1;
		
		info "\n";
	}
}


# Append a single line to a file
# Creates the file if it doesn't exist
sub add_line {
	my @params = @_;
	
	my $LINE = $params[0];
	my $FILENAME = $params[1];
	
	open (my $temp, ">>", "$FILENAME");
	say $temp "$LINE";
	close($temp);
}



# Compute the directory name for a module from %module_info and %modules
# Follows the same convention as get_repo: repo-FILTER_TAG (dots replaced with dashes)
sub module_dir {
	my ($key) = @_;
	my $tag = $modules{$key};
	$tag =~ s/\./-/g;
	return "$module_info{$key}{repo}-$tag";
}


# Apply a list of patch operations to a module directory.
# Handles the exists/update guard, chdir in/out, and dispatches operations.
# Each patch is a hashref with an 'op' key and operation-specific fields.
# Optional 'cond' key is a code ref; patch is skipped if it returns false.
#
# Supported operations:
#   substitute      - {search, replace, file}
#   substitute_glob - {search, replace, pattern}
#   add_line        - {line, file}
#   write_file      - {file, lines => [...]}
#   copy            - {src, dst}
#   unlink          - {file}
#   unlink_glob     - {pattern}
#   init_submodules - {paths => [...]}

sub apply_patches {
	my ($key, $patches_ref) = @_;
	
	return unless exists($modules{$key});
	return if $UPDATE && !$updated{$key};
	
	my $dir = module_dir($key);
	
	chdir $dir or die "ERROR: Cannot enter directory $dir: $!\n";
	
	foreach my $patch (@{$patches_ref})
	{
		if (exists($patch->{cond}))
		{
			next unless $patch->{cond}->();
		}
		
		my $op = $patch->{op};
		
		if    ($op eq "substitute")      { do_substitution($patch->{search}, $patch->{replace}, $patch->{file}); }
		elsif ($op eq "substitute_glob") { foreach my $f (glob($patch->{pattern})) { do_substitution($patch->{search}, $patch->{replace}, $f); } }
		elsif ($op eq "add_line")        { add_line($patch->{line}, $patch->{file}); }
		elsif ($op eq "write_file")      { unlink($patch->{file}); foreach my $l (@{$patch->{lines}}) { add_line($l, $patch->{file}); } }
		elsif ($op eq "copy")            { copy($patch->{src}, $patch->{dst}); }
		elsif ($op eq "unlink")          { unlink($patch->{file}); }
		elsif ($op eq "unlink_glob")     { foreach my $f (glob($patch->{pattern})) { unlink($f); } }
		elsif ($op eq "init_submodules") { my @paths = exists($patch->{paths}) ? @{$patch->{paths}} : ();
		                                   run_cmd("git", "submodule", "update", "--init", @paths);
		                                   warn "WARNING: git submodule update --init failed for $key\n" if $? != 0; }
		else                             { warn "WARNING: Unknown patch operation '$op' for $key\n"; }
	}
	
	chdir ".." or die "ERROR: Cannot return to parent directory: $!\n";
}


