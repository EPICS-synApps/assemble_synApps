		# Write out-of-tree autotools wrapper Makefile
		open(my $mf, ">", "libuldaq/Makefile") or die "ERROR: Cannot write libuldaq/Makefile: $!\n";
		print $mf <<'ULDAQ_MAKEFILE';
# Makefile for building libuldaq per EPICS_HOST_ARCH
# Uses out-of-tree autotools builds so multiple architectures can coexist.

TOP_DIR     := $(abspath .)
BUILD_DIR   := $(TOP_DIR)/build-$(EPICS_HOST_ARCH)
INSTALL_DIR := $(TOP_DIR)/$(EPICS_HOST_ARCH)

all install: $(INSTALL_DIR)/lib/libuldaq.a

$(INSTALL_DIR)/lib/libuldaq.a:
	@echo "Building libuldaq for $(EPICS_HOST_ARCH)..."
	mkdir -p $(BUILD_DIR)
	cd $(BUILD_DIR) && $(TOP_DIR)/configure --prefix=$(INSTALL_DIR)
	$(MAKE) -C $(BUILD_DIR)
	-$(MAKE) -C $(BUILD_DIR) install
	@echo "libuldaq installed to $(INSTALL_DIR)"

clean:
	rm -rf $(BUILD_DIR)

distclean realclean:
	rm -rf build-* $(wildcard rhel*) $(wildcard linux-*)

rebuild: distclean all

uninstall:
	rm -rf $(INSTALL_DIR)

.PHONY: all install clean distclean realclean rebuild uninstall
ULDAQ_MAKEFILE
		close($mf);
		
		# Write arch-aware CONFIG_SITE.local using measComp's ULDAQ_DIR/ULDAQ_INCLUDE
		unlink("configure/CONFIG_SITE.local");
		add_line('ULDAQ_DIR=$(TOP)/libuldaq/$(EPICS_HOST_ARCH)/lib', "./configure/CONFIG_SITE.local");
		add_line('ULDAQ_INCLUDE=$(TOP)/libuldaq/$(EPICS_HOST_ARCH)/include', "./configure/CONFIG_SITE.local");
		
		# Add libuldaq to DIRS in measComp's top-level Makefile
		do_substitution(
			'DIRS := \$\(DIRS\) measCompSupport',
			'DIRS := $(DIRS) $(filter-out $(DIRS), $(wildcard libuldaq))' . "\n" . 'DIRS := $(DIRS) measCompSupport',
			"Makefile"
		);
		do_substitution(
			'measCompApp_DEPEND_DIRS \+= measCompSupport',
			"measCompSupport_DEPEND_DIRS += libuldaq\nmeasCompApp_DEPEND_DIRS += measCompSupport",
			"Makefile"
		);
