		{
			foreach my $submod (split(/\s+/, $val // ''))
			{
				validate_tag("$key entry", $submod) if $submod ne '';
			}
		}
		elsif (defined $val && $val ne '')
		{
			validate_tag($key, $val);
		}
		
		$modules{$key} = $val // '';
	}
	
	close($releasehandle);
}

