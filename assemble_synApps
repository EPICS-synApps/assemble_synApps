	while(my $line = <$releasehandle>)
	{
		#Strip newline
		$line =~ s/\R\z//g;
		
		# Skip blank lines and comments
		next if $line =~ /^\s*$/;
		next if $line =~ /^\s*#/;
		
		# Split on first '=' only, trim whitespace
		my ($key, $val) = split(/=/, $line, 2);
		
		$key =~ s/^\s+|\s+$//g;
		$val =~ s/^\s+|\s+$//g if defined $val;
		
		validate_tag($key, $key);
		
